{
  "config": {
    "step": {
      "user": {
        "title": "Add a heat recovery ventilation unit",
        "description": "Enter the IP address of the unit on your network (Wi-Fi or Ethernet). You can find it in the unit's mobile app or in your router's device list.\n\nNeed filters or accessories? [econology.fr]({shop_url})",
        "data": {
          "host": "IP address",
          "model": "Model"
        },
        "data_description": {
          "host": "Example: 192.168.1.50. Give it a fixed address in your router so it does not change.",
          "model": "Used to name the device and to suggest the right replacement filters."
        },
        "sections": {
          "advanced": {
            "name": "Advanced settings",
            "data": {
              "port": "Modbus TCP port",
              "unit_id": "Modbus address"
            },
            "data_description": {
              "port": "502 unless configured otherwise.",
              "unit_id": "1 by default."
            }
          }
        }
      },
      "reconfigure": {
        "title": "Change the connection",
        "data": {
          "host": "IP address",
          "model": "Model"
        },
        "data_description": {
          "host": "Example: 192.168.1.50. Give it a fixed address in your router so it does not change.",
          "model": "Used to name the device and to suggest the right replacement filters."
        },
        "sections": {
          "advanced": {
            "name": "Advanced settings",
            "data": {
              "port": "Modbus TCP port",
              "unit_id": "Modbus address"
            },
            "data_description": {
              "port": "502 unless configured otherwise.",
              "unit_id": "1 by default."
            }
          }
        }
      }
    },
    "error": {
      "cannot_connect": "The unit cannot be reached. Check the IP address, and that no other system (BMS, other home automation) already holds the Modbus TCP connection: the unit accepts only one.",
      "not_a21": "A device answers at this address, but it is not an A21 controller."
    },
    "abort": {
      "already_configured": "This unit is already configured.",
      "reconfigure_successful": "Connection updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Polling interval",
          "manual_bypass": "Bypass driven by Home Assistant"
        },
        "data_description": {
          "scan_interval": "Time between two readings of the unit (15 s by default).",
          "manual_bypass": "Tick if you drive the bypass yourself (card, automations). The unit's “Bypass in manual mode” warning is then no longer reported, neither on the cards nor by the alarm sensors. Mind that without a preheater, the bypass is what protects the exchanger from frost: switch back to automatic in winter."
        }
      }
    }
  },
